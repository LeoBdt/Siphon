# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/

# Env
.env
.env.local
.env.*.local

# Data (SQLite db + downloaded media).
# Anchored to the repository root: without the leading slash these match any
# directory of that name at any depth, which silently swallowed the Next.js
# route at apps/web/src/app/settings/downloads/.
/data/
/downloads/
*.sqlite
*.sqlite-journal
*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Working notes stay local: the only Markdown the repo carries is its README.
*.md
!/README.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.tsbuildinfo
coverage/
