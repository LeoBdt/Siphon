# Port the API listens on
PORT=3001

# Root directory the file manager is sandboxed to.
# All file operations and downloads are confined below this path.
# On Windows use forward slashes or escaped backslashes.
ROOT_DIR=./data/library

# Scratch space for downloads in progress (partials, fragments, thumbnails).
# Must NOT be inside ROOT_DIR, and should sit on the same volume so the final
# move is a rename. Defaults to a "tmp" folder next to ROOT_DIR.
# TMP_DIR=./data/tmp

# Path to the yt-dlp binary (leave as "yt-dlp" if on PATH)
YTDLP_PATH=yt-dlp

# Path to ffmpeg (leave as "ffmpeg" if on PATH)
FFMPEG_PATH=ffmpeg

# Max simultaneous downloads — INITIAL value only. Once changed from the
# Réglages page the value is persisted in the database and takes precedence
# over this variable on every subsequent boot.
MAX_CONCURRENT_DOWNLOADS=2

# Allowed web origin for CORS (the Next.js dev server)
WEB_ORIGIN=http://localhost:3000
